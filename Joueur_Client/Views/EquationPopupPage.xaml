<UserControl x:Class="Joueur_Client.Views.EquationPopupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Joueur_Client.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Border Style="{StaticResource Cartouche}" BorderBrush="{StaticResource SignalBrush}" Width="440">
        <StackPanel Margin="24">
            <TextBlock Text="Réponds juste pour activer ta défense." Style="{StaticResource LeadText}"/>
            <TextBlock Text="{Binding Equation}" Style="{StaticResource HeadingText}"
                   TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"/>
            <TextBox x:Name="AnswerBox" Text="{Binding AnswerString, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FormTextBox}" Margin="0,16,0,20"/>
            <Button Content="Valider" Style="{StaticResource SignalButton}"
                Command="{Binding ConfirmCommand}" IsDefault="True" HorizontalAlignment="Right"/>
        </StackPanel>
    </Border>
    
</UserControl>
