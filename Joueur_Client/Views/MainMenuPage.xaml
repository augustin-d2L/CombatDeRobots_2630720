<UserControl x:Class="Joueur_Client.Views.MainMenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="450"
             d:Background="{StaticResource BlueprintBackgroundBrush}">

    <Grid Margin="48,28,48,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Combat de robots" Style="{StaticResource BrandText}" VerticalAlignment="Center"/>
            <Border DockPanel.Dock="Right" Style="{StaticResource RoleTag}">
                <TextBlock Text="Client" Style="{StaticResource RoleTagText}"/>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">

            <Border Margin="0,0,0,24">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AlertBox}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Message}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Message}" Style="{StaticResource AlertText}"/>
            </Border>

            <TextBlock Text="Rejoindre une partie" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Entre l'adresse IP et le port affichés sur l'écran du joueur qui héberge."
                       Style="{StaticResource LeadText}"
                       Margin="0,8,0,24"/>

            <Border Style="{StaticResource Cartouche}" HorizontalAlignment="Left" Width="460">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="20,14,24,18">
                        <TextBlock Text="Adresse IP" Style="{StaticResource FieldLabelText}"/>
                        <TextBox Style="{StaticResource FormTextBox}" FontSize="24" Margin="0,4,0,0"
                                 IsReadOnly="{Binding IsConnecting}"
                                 Text="{Binding IpInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1,0,0,0">
                        <StackPanel Margin="20,14,20,18">
                            <TextBlock Text="Port" Style="{StaticResource FieldLabelText}"/>
                            <TextBox Style="{StaticResource FormTextBox}" FontSize="24" Margin="0,4,0,0"
                                     MaxLength="5"
                                     IsReadOnly="{Binding IsConnecting}"
                                     Text="{Binding PortInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <Grid Margin="20,12">
                            <Button Content="Se connecter"
                                    Command="{Binding ConnectToGameCommand}"
                                    IsDefault="True"
                                    HorizontalAlignment="Left">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SignalButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}">
                                <Ellipse Style="{StaticResource LiveDot}"/>
                                <TextBlock Text="Connexion au serveur…"
                                           Style="{StaticResource BodyText}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
