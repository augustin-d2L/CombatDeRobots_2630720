<UserControl x:Class="Joueur_Client.Views.MainMenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Joueur_Client.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="IP address :" />
            <TextBox Width="300" Text="{Binding IpInput}"/>
            <TextBlock Text="Port :" />
            <TextBox Width="300" Text="{Binding PortInput, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Search Game" Command="{Binding ConnectToGameCommand, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </Grid>
</UserControl>
