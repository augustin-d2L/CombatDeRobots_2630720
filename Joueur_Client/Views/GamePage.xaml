<UserControl x:Class="Joueur_Client.Views.GamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="560"
             d:Background="{StaticResource BlueprintBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="48,24,48,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Combat de robots" Style="{StaticResource BrandText}" VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource RoleTag}">
                    <TextBlock Text="Client" Style="{StaticResource RoleTagText}"/>
                </Border>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Cartouche}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTurnToPlay}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="16,10">
                                <TextBlock DockPanel.Dock="Right" Text="Toi" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Text="{Binding RobotName}" Style="{StaticResource HeadingText}"/>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="16,12,16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                <TextBlock Text="Vie" Style="{StaticResource FieldLabelText}"/>
                                <TextBlock Text="{Binding HealthPoints}" Style="{StaticResource FieldValueText}"/>
                            </StackPanel>

                            <Grid Grid.Column="1" Margin="16,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Armure" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Armor}" Style="{StaticResource StatValueText}" FontSize="17"/>
                                <TextBlock Grid.Row="1" Text="Attaque" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Damage}" Style="{StaticResource StatValueText}" FontSize="17"/>
                                <TextBlock Grid.Row="2" Text="Énergie" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Energy}" Style="{StaticResource StatValueText}" FontSize="17"/>
                                <TextBlock Grid.Row="3" Text="Bonus de défense" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DefenseBonus}" Style="{StaticResource StatValueText}" FontSize="17"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Cartouche}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTurnToPlay}" Value="False">
                                    <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="16,10">
                                <TextBlock DockPanel.Dock="Right" Text="Adversaire" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Text="{Binding EnnemyRobotName}" Style="{StaticResource HeadingText}"/>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="16,12,16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                <TextBlock Text="Vie" Style="{StaticResource FieldLabelText}"/>
                                <TextBlock Text="{Binding EnnemyHealthPoints}" Style="{StaticResource FieldValueText}"/>
                            </StackPanel>

                            <Grid Grid.Column="1" Margin="16,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Armure" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EnnemyArmor}" Style="{StaticResource StatValueText}" FontSize="17"/>
                                <TextBlock Grid.Row="1" Text="Attaque" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EnnemyDamage}" Style="{StaticResource StatValueText}" FontSize="17"/>
                                <TextBlock Grid.Row="2" Text="Énergie" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EnnemyEnergy}" Style="{StaticResource StatValueText}" FontSize="17"/>
                                <TextBlock Grid.Row="3" Text="Bonus de défense" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EnnemyDefenseBonus}" Style="{StaticResource StatValueText}" FontSize="17"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Margin="0,16,0,0" Padding="14,10"
                    Background="{StaticResource BlueprintDeepBrush}"
                    BorderBrush="{StaticResource PaleLineBrush}" BorderThickness="3,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Message}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
            </Border>

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" Text="Choisis une action" Style="{StaticResource HeadingText}" VerticalAlignment="Center"/>

                    <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="À toi de jouer"
                                   Style="{StaticResource HeadingText}"
                                   Foreground="{StaticResource SignalBrush}"
                                   Visibility="{Binding IsTurnToPlay, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTurnToPlay}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Ellipse Style="{StaticResource LiveDot}"/>
                            <TextBlock Text="Tour de l'adversaire…" Style="{StaticResource BodyText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-10,0" IsEnabled="{Binding IsTurnToPlay}">
                    <RadioButton Style="{StaticResource ActionChip}" Margin="0,0,10,0"
                                 GroupName="ChosenAction"
                                 Content="Attaque" Tag="Inflige tes dégâts à l'adversaire."
                                 Command="{Binding SelectActionCommand}" CommandParameter="ATTACK"/>
                    <RadioButton Style="{StaticResource ActionChip}" Margin="0,0,10,0"
                                 GroupName="ChosenAction"
                                 Content="Attaque puissante" Tag="Plus de dégâts, coûte de l'énergie."
                                 Command="{Binding SelectActionCommand}" CommandParameter="POWERFUL_ATTACK"/>
                    <RadioButton Style="{StaticResource ActionChip}" Margin="0,0,10,0"
                                 GroupName="ChosenAction"
                                 Content="Défense" Tag="Augmente ton bonus de défense."
                                 Command="{Binding SelectActionCommand}" CommandParameter="DEFENSE"/>
                    <RadioButton Style="{StaticResource ActionChip}" Margin="0,0,10,0"
                                 GroupName="ChosenAction"
                                 Content="Recharge" Tag="Regagne de l'énergie."
                                 Command="{Binding SelectActionCommand}" CommandParameter="RECHARGE"/>
                </UniformGrid>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Message à l'adversaire"
                               Style="{StaticResource FieldLabelText}"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="16,0,24,0"
                             Style="{StaticResource FormTextBox}"
                             IsEnabled="{Binding IsTurnToPlay}"
                             Text="{Binding MessageToSend, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="Jouer le tour"
                            Style="{StaticResource SignalButton}"
                            Command="{Binding PlayTurnCommand}"/>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
