<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Thème "plan technique" (blueprint) : fond bleu quadrillé, traits à la craie,
        jaune signal pour ce qui est actif, rouge crayon pour les problèmes.
        L'ordre compte : une ressource doit être définie AVANT d'être utilisée en StaticResource.
    -->

    <!-- ===================== Couleurs ===================== -->
    <Color x:Key="BlueprintColor">#123B66</Color>
    <Color x:Key="BlueprintDeepColor">#0C2C4F</Color>
    <Color x:Key="GridMinorColor">#1A4673</Color>
    <Color x:Key="GridMajorColor">#255587</Color>
    <Color x:Key="ChalkColor">#EEF4FA</Color>
    <Color x:Key="PaleLineColor">#A9C3DD</Color>
    <Color x:Key="RuleColor">#6F92B6</Color>
    <Color x:Key="SignalColor">#FFD54A</Color>
    <Color x:Key="SignalHoverColor">#FFE07A</Color>
    <Color x:Key="SignalPressedColor">#F0C02E</Color>
    <Color x:Key="RedPencilColor">#FF9A8D</Color>
    <Color x:Key="DisabledFillColor">#1B4673</Color>
    <Color x:Key="DisabledTextColor">#7F9BB8</Color>
    <Color x:Key="ChalkWashColor">#1FEEF4FA</Color>
    <Color x:Key="GainColor">#8BE3A8</Color>
    <SolidColorBrush x:Key="ScrimBrush" Color="#B30C2C4F"/>

    <!-- ===================== Pinceaux ===================== -->
    <SolidColorBrush x:Key="BlueprintBrush" Color="{StaticResource BlueprintColor}"/>
    <SolidColorBrush x:Key="BlueprintDeepBrush" Color="{StaticResource BlueprintDeepColor}"/>
    <SolidColorBrush x:Key="GridMinorBrush" Color="{StaticResource GridMinorColor}"/>
    <SolidColorBrush x:Key="GridMajorBrush" Color="{StaticResource GridMajorColor}"/>
    <SolidColorBrush x:Key="ChalkBrush" Color="{StaticResource ChalkColor}"/>
    <SolidColorBrush x:Key="PaleLineBrush" Color="{StaticResource PaleLineColor}"/>
    <SolidColorBrush x:Key="RuleBrush" Color="{StaticResource RuleColor}"/>
    <SolidColorBrush x:Key="SignalBrush" Color="{StaticResource SignalColor}"/>
    <SolidColorBrush x:Key="SignalHoverBrush" Color="{StaticResource SignalHoverColor}"/>
    <SolidColorBrush x:Key="SignalPressedBrush" Color="{StaticResource SignalPressedColor}"/>
    <SolidColorBrush x:Key="RedPencilBrush" Color="{StaticResource RedPencilColor}"/>
    <SolidColorBrush x:Key="DisabledFillBrush" Color="{StaticResource DisabledFillColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
    <SolidColorBrush x:Key="ChalkWashBrush" Color="{StaticResource ChalkWashColor}"/>
    <SolidColorBrush x:Key="GainBrush" Color="{StaticResource GainColor}"/>

    <!--
        Fond papier millimétré : une tuile de 120 x 120 avec une ligne forte au bord
        et 4 lignes fines tous les 24 px. Les ".5" gardent les traits nets (1 pixel).
        À mettre sur la fenêtre : Background="{StaticResource BlueprintBackgroundBrush}"
    -->
    <DrawingBrush x:Key="BlueprintBackgroundBrush"
                  TileMode="Tile" Stretch="None"
                  Viewport="0,0,120,120" ViewportUnits="Absolute"
                  Viewbox="0,0,120,120" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BlueprintBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,120,120"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M24.5,0 V120 M48.5,0 V120 M72.5,0 V120 M96.5,0 V120 M0,24.5 H120 M0,48.5 H120 M0,72.5 H120 M0,96.5 H120">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource GridMinorBrush}" Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0.5,0 V120 M0,0.5 H120">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource GridMajorBrush}" Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ===================== Police ===================== -->
    <!-- Bahnschrift est installée avec Windows 10/11 (inspirée de la DIN des plans techniques). Segoe UI en secours. -->
    <FontFamily x:Key="DinFont">Bahnschrift, Segoe UI</FontFamily>

    <!-- ===================== Convertisseurs ===================== -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- ===================== Textes ===================== -->
    <Style x:Key="BrandText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DinFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DinFont}"/>
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
    </Style>

    <Style x:Key="LeadText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DinFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource PaleLineBrush}"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DinFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
    </Style>

    <!-- Petite étiquette au-dessus d'une valeur (ex. "Adresse IP") -->
    <Style x:Key="FieldLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DinFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontStretch" Value="Condensed"/>
        <Setter Property="Foreground" Value="{StaticResource PaleLineBrush}"/>
    </Style>

    <!-- Grande valeur à lire (IP, port, stats) ; chiffres tabulaires = alignés -->
    <Style x:Key="FieldValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DinFont}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- Valeur de stat dans un tableau (config, combat) -->
    <Style x:Key="StatValueText" TargetType="TextBlock" BasedOn="{StaticResource FieldValueText}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Titre de bloc (nom d'un robot, titre d'une section) -->
    <Style x:Key="HeadingText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DinFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- "(+10)" en vert, caché quand le bonus est nul -->
    <Style x:Key="GainText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DinFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource GainBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="(+0)">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AlertText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DinFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource RedPencilBrush}"/>
    </Style>

    <!-- ===================== Conteneurs ===================== -->

    <!-- Étiquette de rôle en haut à droite ("Serveur" / "Client") -->
    <Style x:Key="RoleTag" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource PaleLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RoleTagText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DinFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource PaleLineBrush}"/>
    </Style>

    <!-- Cartouche : le bloc d'informations encadré qu'on trouve dans le coin des plans techniques -->
    <Style x:Key="Cartouche" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BlueprintDeepBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Note "au crayon rouge" pour signaler un problème -->
    <Style x:Key="AlertBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BlueprintDeepBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RedPencilBrush}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ===================== Indicateur "en direct" ===================== -->
    <!-- Pastille jaune qui pulse. Ne s'anime pas si l'utilisateur a désactivé les animations dans Windows. -->
    <Style x:Key="LiveDot" TargetType="Ellipse">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Fill" Value="{StaticResource SignalBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.9"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Boutons ===================== -->

    <!-- Gabarit commun : une plaque + un anneau de focus visible au clavier (Tab) -->
    <ControlTemplate x:Key="PlateButtonTemplate" TargetType="Button">
        <Grid>
            <Border x:Name="Plate"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="2"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <Border x:Name="FocusRing"
                    BorderBrush="{StaticResource ChalkBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Margin="-4"
                    Visibility="Collapsed"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Bouton principal : l'action importante de la page -->
    <Style x:Key="SignalButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PlateButtonTemplate}"/>
        <Setter Property="Background" Value="{StaticResource SignalBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource BlueprintDeepBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="FontFamily" Value="{StaticResource DinFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SignalHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource SignalPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource DisabledFillBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bouton secondaire : tracé à la craie (ex. +/- de la config, Quitter) -->
    <Style x:Key="ChalkButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PlateButtonTemplate}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PaleLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontFamily" Value="{StaticResource DinFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ChalkWashBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ChalkBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BlueprintDeepBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{StaticResource DisabledFillBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Petit bouton carré pour les + / − -->
    <Style x:Key="StepperButton" TargetType="Button" BasedOn="{StaticResource ChalkButton}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <!-- ===================== Champ texte ===================== -->
    <!-- Une simple ligne à remplir, comme sur un formulaire de plan -->
    <Style x:Key="FormTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource DinFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource ChalkBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource SignalBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource PaleLineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}"/>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Foreground" Value="{StaticResource PaleLineBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DisabledFillBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DisabledFillBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Choix d'action ===================== -->
    <!--
        RadioButton en forme de plaque : Content = nom de l'action, Tag = courte explication.
        Cochée = plaque jaune. Désactivée = grisée (ex. pendant le tour adverse).
    -->
    <Style x:Key="ActionChip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource PaleLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="FontFamily" Value="{StaticResource DinFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Plate"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <StackPanel>
                                <ContentPresenter RecognizesAccessKey="True"/>
                                <TextBlock x:Name="Hint"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="13"
                                           FontWeight="Normal"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource PaleLineBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="FocusRing"
                                BorderBrush="{StaticResource ChalkBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Margin="-4"
                                Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Hint" Property="Foreground" Value="{StaticResource BlueprintDeepBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Hint" Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ChalkWashBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ChalkBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource SignalBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SignalBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource BlueprintDeepBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{StaticResource DisabledFillBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>