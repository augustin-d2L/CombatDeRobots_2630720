<UserControl x:Class="Joueur_Server.Views.MainMenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="450"
             d:Background="{StaticResource BlueprintBackgroundBrush}">

    <Grid Margin="48,28,48,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Combat de robots" Style="{StaticResource BrandText}" VerticalAlignment="Center"/>
            <Border DockPanel.Dock="Right" Style="{StaticResource RoleTag}">
                <TextBlock Text="Serveur" Style="{StaticResource RoleTagText}"/>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">

            <Border Margin="0,0,0,24">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AlertBox}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Message}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Message}" Style="{StaticResource AlertText}"/>
            </Border>

            <TextBlock Text="Héberger une partie" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Donne cette adresse à l'autre joueur pour qu'il puisse se connecter."
                       Style="{StaticResource LeadText}"
                       Margin="0,8,0,24"/>

            <Border Style="{StaticResource Cartouche}" HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="260"/>
                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="20,14,24,16">
                        <TextBlock Text="Adresse IP" Style="{StaticResource FieldLabelText}"/>
                        <TextBlock Text="{Binding LocalIp}" Style="{StaticResource FieldValueText}"/>
                    </StackPanel>

                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1,0,0,0">
                        <StackPanel Margin="20,14,24,16">
                            <TextBlock Text="Port" Style="{StaticResource FieldLabelText}"/>
                            <TextBlock Text="{Binding Port}" Style="{StaticResource FieldValueText}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                        <Grid Margin="20,12">
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsHosting, Converter={StaticResource BoolToVisibility}}">
                                <Ellipse Style="{StaticResource LiveDot}"/>
                                <TextBlock Text="En attente d'un adversaire…"
                                           Style="{StaticResource BodyText}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Content="Héberger une partie"
                                    Command="{Binding HostGameCommand}"
                                    HorizontalAlignment="Left">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SignalButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHosting}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
