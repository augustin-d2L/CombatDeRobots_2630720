<Window x:Class="Joueur_Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Joueur_Server.ViewModels"
        xmlns:views="clr-namespace:Joueur_Server.Views"
        xmlns:local="clr-namespace:Joueur_Server"
        mc:Ignorable="d"
        Title="Combat de Robots" Height="720" Width="1280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--Associate each viewModel with their view-->
        <DataTemplate DataType="{x:Type vm:MainMenuViewModel}">
            <views:MainMenuPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigurationViewModel}">
            <views:ConfigurationPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameViewModel}">
            <views:GamePage />
        </DataTemplate>
    </Window.Resources>
    
    <!--Content control shows automatically the right page 
        depending of the type of the current ViewModels-->
    <ContentControl Content="{Binding CurrentPage}" />

</Window>
