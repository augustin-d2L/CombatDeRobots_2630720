<UserControl x:Class="Joueur_Server.Views.ConfigurationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="450"
             d:Background="{StaticResource BlueprintBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="48,28,48,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Combat de robots" Style="{StaticResource BrandText}" VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource RoleTag}">
                    <TextBlock Text="Serveur" Style="{StaticResource RoleTagText}"/>
                </Border>
            </DockPanel>

            <StackPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,20,0,0">

                <TextBlock Text="Configurer ton robot" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Répartis tes points entre la vie, l'armure et l'attaque, puis confirme."
                           Style="{StaticResource LeadText}"
                           Margin="0,6,0,20"/>

                <Border Style="{StaticResource Cartouche}" Width="520" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="20,14,20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nom du robot"
                                       Style="{StaticResource FieldLabelText}"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Margin="16,0,0,0"
                                     Style="{StaticResource FormTextBox}"
                                     MaxLength="20"
                                     IsReadOnly="{Binding IsReady}"
                                     Text="{Binding RobotName, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                            <Grid Margin="20,10,20,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Points" Style="{StaticResource FieldLabelText}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Résultat" Style="{StaticResource FieldLabelText}" Margin="32,0,0,0"/>

                                <!-- Vie -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Vie" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="−" Style="{StaticResource StepperButton}"
                                            Command="{Binding DecrementCommand}" CommandParameter="Hp"
                                            AutomationProperties.Name="Retirer un point de vie"/>
                                    <TextBlock Text="{Binding HpPoints}" Style="{StaticResource StatValueText}" Width="40" TextAlignment="Center"/>
                                    <Button Content="+" Style="{StaticResource StepperButton}"
                                            Command="{Binding IncrementCommand}" CommandParameter="Hp"
                                            AutomationProperties.Name="Ajouter un point de vie"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="32,0,0,0">
                                    <TextBlock Text="{Binding PreviewHealthPoints}" Style="{StaticResource StatValueText}" MinWidth="48"/>
                                    <TextBlock Text="{Binding HpBonus, StringFormat='(+{0})'}" Style="{StaticResource GainText}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Armure" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="−" Style="{StaticResource StepperButton}"
                                            Command="{Binding DecrementCommand}" CommandParameter="Armor"
                                            AutomationProperties.Name="Retirer un point d'armure"/>
                                    <TextBlock Text="{Binding ArmorPoints}" Style="{StaticResource StatValueText}" Width="40" TextAlignment="Center"/>
                                    <Button Content="+" Style="{StaticResource StepperButton}"
                                            Command="{Binding IncrementCommand}" CommandParameter="Armor"
                                            AutomationProperties.Name="Ajouter un point d'armure"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="32,0,0,0">
                                    <TextBlock Text="{Binding PreviewArmor}" Style="{StaticResource StatValueText}" MinWidth="48"/>
                                    <TextBlock Text="{Binding ArmorBonus, StringFormat='(+{0})'}" Style="{StaticResource GainText}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Attaque" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="−" Style="{StaticResource StepperButton}"
                                            Command="{Binding DecrementCommand}" CommandParameter="Damage"
                                            AutomationProperties.Name="Retirer un point d'attaque"/>
                                    <TextBlock Text="{Binding DamagePoints}" Style="{StaticResource StatValueText}" Width="40" TextAlignment="Center"/>
                                    <Button Content="+" Style="{StaticResource StepperButton}"
                                            Command="{Binding IncrementCommand}" CommandParameter="Damage"
                                            AutomationProperties.Name="Ajouter un point d'attaque"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="32,0,0,0">
                                    <TextBlock Text="{Binding PreviewDamage}" Style="{StaticResource StatValueText}" MinWidth="48"/>
                                    <TextBlock Text="{Binding DamageBonus, StringFormat='(+{0})'}" Style="{StaticResource GainText}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
                            <Grid Margin="20,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Points à répartir" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding RemainingPoints}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValueText}">
                                                <Setter Property="Foreground" Value="{StaticResource SignalBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RemainingPoints}" Value="0">
                                                        <Setter Property="Foreground" Value="{StaticResource ChalkBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Grid Grid.Column="1">
                                    <Button Content="Confirmer" Command="{Binding ConfirmCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SignalButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                                        <Ellipse Style="{StaticResource LiveDot}"/>
                                        <TextBlock Text="En attente de l'autre joueur…"
                                                   Style="{StaticResource BodyText}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
